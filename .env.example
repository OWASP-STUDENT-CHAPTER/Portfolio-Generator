# =========================================================
# Platform Environment Variables Template
# =========================================================

# Platform Branding
NEXT_PUBLIC_APP_NAME="Folio"
NEXT_PUBLIC_APP_TAGLINE="Personal Portfolios Made Effortless"

# Supabase / PostgreSQL Database URLs
# DATABASE_URL: Session/Transaction pooler (Port 6543) with pgbouncer=true
# DIRECT_URL: Direct database connection (Port 5432) for migrations
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=10"
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# NextAuth / Auth.js Configuration
AUTH_SECRET="generate-a-secure-random-32-character-secret"
AUTH_TRUST_HOST="true"

# Google OAuth 2.0 Credentials (From Google Cloud Console)
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Allowed Google Email Domains ("*" allows any Google account, or comma-separated e.g. "example.com,edu.in")
ALLOWED_EMAIL_DOMAINS="*"

# Admin accounts with moderation & management privileges (comma-separated)
ADMIN_EMAILS="admin@example.com,samito@example.com"

# Domain & Routing Configuration
# In Local Dev: NEXT_PUBLIC_ROOT_DOMAIN="localhost:3000" and NEXT_PUBLIC_PROTOCOL="http"
# In Production: NEXT_PUBLIC_ROOT_DOMAIN="yourdomain.com" and NEXT_PUBLIC_PROTOCOL="https"
NEXT_PUBLIC_ROOT_DOMAIN="localhost:3000"
NEXT_PUBLIC_PROTOCOL="http"

# Hive Content Moderation API Keys (Round-Robin Cycling 1 to 6)
HIVE_ACCESS_KEY_1=""
HIVE_SECRET_KEY_1=""

HIVE_ACCESS_KEY_2=""
HIVE_SECRET_KEY_2=""

HIVE_ACCESS_KEY_3=""
HIVE_SECRET_KEY_3=""

HIVE_ACCESS_KEY_4=""
HIVE_SECRET_KEY_4=""

HIVE_ACCESS_KEY_5=""
HIVE_SECRET_KEY_5=""

HIVE_ACCESS_KEY_6=""
HIVE_SECRET_KEY_6=""

# Text Moderation Mode: "LOCAL_FIRST" (strict offline keyword filters) or "HYBRID" (local + Hive API)
TEXT_MODERATION_MODE="HYBRID"
